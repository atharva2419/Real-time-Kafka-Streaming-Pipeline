# Copy to .env and edit as needed. Defaults suit `docker compose up`.

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=wiki-edits
KAFKA_PARTITIONS=6
KAFKA_CONSUMER_GROUP=wiki-aggregator

REDIS_HOST=localhost
REDIS_PORT=6379
HISTORY_MAX=120
# /healthz reports degraded when the newest window is older than this.
STALE_AFTER_SECONDS=30
# Safety-net TTL on each window hash; 0 means HISTORY_MAX * WINDOW_SECONDS * 2.
WINDOW_TTL_SECONDS=0

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=wiki

WINDOW_SECONDS=5
WINDOW_GRACE_SECONDS=1.0
# arrival | event  -- see docs/DESIGN.md
WINDOW_TIME_SOURCE=arrival
MAX_GAP_WINDOWS=12

API_HOST=0.0.0.0
API_PORT=8000
