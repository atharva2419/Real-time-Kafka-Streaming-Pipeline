# Copy to .env and edit as needed. Defaults suit `docker compose up`.

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=wiki-edits
KAFKA_PARTITIONS=6
KAFKA_CONSUMER_GROUP=wiki-aggregator

REDIS_HOST=localhost
REDIS_PORT=6379
HISTORY_MAX=120
LATEST_TTL_SECONDS=30

WINDOW_SECONDS=5
WINDOW_GRACE_SECONDS=1.0
# arrival | event  -- see docs/DESIGN.md
WINDOW_TIME_SOURCE=arrival
MAX_GAP_WINDOWS=12

API_HOST=0.0.0.0
API_PORT=8000
